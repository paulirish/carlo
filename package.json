{
  "name": "carlo",
  "version": "0.9.46",
  "description": "Carlo is a framework for rendering Node data structures using Chrome browser.",
  "repository": "github:GoogleChromeLabs/carlo",
  "engines": {
    "node": ">=18.0.0"
  },
  "main": "index.js",
  "directories": {
    "lib": "lib"
  },
  "scripts": {
    "lint": "eslint .",
    "download-browser": "node scripts/download-browser.js",
    "test:unit": "node --test test/find_chrome.spec.js test/security.spec.js rpc/test.js test/color.spec.js",
    "test:browser": "node --test test/app.spec.js",
    "test": "npm run test:unit && npm run test:browser",
    "headful-test": "node test/headful.js"
  },
  "keywords": [],
  "author": "The Chromium Authors",
  "license": "Apache-2.0",
  "dependencies": {
    "@puppeteer/browsers": "^2.7.0",
    "debug": "^4.3.4",
    "mime-types": "^2.1.35",
    "puppeteer-core": "^25.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^8.57.0",
    "eslint": "^8.57.0",
    "globals": "^15.0.0"
  }
}

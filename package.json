{
  "name": "carlo",
  "version": "0.9.46",
  "description": "Carlo is a framework for rendering Node data structures using Chrome browser.",
  "repository": "github:GoogleChromeLabs/carlo",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "clean": "node --input-type=module --eval \"import {rmSync} from 'node:fs'; rmSync('dist', {recursive: true, force: true})\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "lint": "eslint . && tsc -p tsconfig.json --noEmit",
    "download-browser": "npm run build && node dist/scripts/download-browser.js",
    "test:unit": "node --test --test-timeout=10000 test/modern/harness.test.mjs",
    "test:browser": "node --test --test-timeout=45000 test/modern/puppeteer-driver.test.mjs",
    "test:pack": "node test/packed-consumer.mjs",
    "test": "npm run build && npm run test:unit && npm run test:browser && npm run test:pack",
    "headful-test": "node test/headful.js",
    "prepack": "npm run build"
  },
  "keywords": [],
  "author": "The Chromium Authors",
  "license": "Apache-2.0",
  "dependencies": {
    "@puppeteer/browsers": "3.2.2",
    "debug": "4.4.3",
    "mime-types": "3.0.2",
    "puppeteer-core": "25.10.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "24.3.1",
    "eslint": "9.39.5",
    "globals": "17.12.0",
    "proxy-agent": "8.0.1",
    "typescript": "5.9.2"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "type": "module"
}
